# MongoDB Connection String
DATABASE_URL="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<database_name>?retryWrites=true&w=majority"

# Session Secret (Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="your-auth-secret-here"

# App URL (Optional for local dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
